{
  "name": "dsh-puzzle-plugin",
  "version": "0.2.0",
  "description": "莉娅拼图插件：滑块拼图小游戏，随时可玩，莉娅能发话/换图/看进度",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:client": "node client/build.mjs"
  },
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./client.js"
    }
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5"
  }
}
